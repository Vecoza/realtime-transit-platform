      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Since data was last stored",
      "description": "Orange after a minute; red from five minutes, where the alert 'No data for 5 minutes' fires on the same value.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(committed_at)) AS seconds\nFROM meta.consumer_metrics\nWHERE inserted > 0 AND committed_at > now() - interval '1 day'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
