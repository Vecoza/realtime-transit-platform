    {
      "id": 6,
      "type": "barchart",
      "title": "On time by hour (measured delay vs timetable)",
      "description": "Share of departures at timing points between 60 s early and 180 s late, per local hour.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT lpad(hour_local::text, 2, '0') || ':00' AS hour,\n       round((sum(on_time)::float / nullif(sum(departures), 0) * 100)::numeric, 1) AS on_time_pct\nFROM marts.mart_on_time_performance\nWHERE service_date = '$day' AND mode IN ($mode)\nGROUP BY hour_local\nORDER BY hour_local"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "on_time_pct"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "on time"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "hour",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.8,
        "showValue": "never"
      }
    },
    {
      "id": 7,
      "type": "trend",
      "title": "Average delay by hour (measured delay vs timetable)",
      "description": "Average departure delay at timing points per local hour (0 to 23), positive when late. Hours without departures are left empty.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH by_hour AS (\n    SELECT hour_local,\n           round((sum(avg_delay_s * departures) / nullif(sum(departures), 0))::numeric) AS avg_delay_s\n    FROM marts.mart_on_time_performance\n    WHERE service_date = '$day' AND mode IN ($mode)\n    GROUP BY hour_local\n)\nSELECT hours.hour, by_hour.avg_delay_s\nFROM generate_series((SELECT min(hour_local) FROM by_hour), (SELECT max(hour_local) FROM by_hour)) AS hours (hour)\nLEFT JOIN by_hour ON by_hour.hour_local = hours.hour\nORDER BY hours.hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_delay_s"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "average delay"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hour"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "hour"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "hour",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Lines (measured delay vs timetable)",
      "description": "Lines with at least ten departures at timing points that day, least punctual first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT route_short_name AS line, mode,\n       sum(departures) AS departures,\n       round((sum(on_time)::float / sum(departures))::numeric, 3) AS on_time_share,\n       round((sum(avg_delay_s * departures) / sum(departures))::numeric) AS avg_delay_s,\n       max(p90_delay_s) AS worst_hour_p90_s\nFROM marts.mart_on_time_performance\nWHERE service_date = '$day' AND mode IN ($mode)\nGROUP BY 1, 2\nHAVING sum(departures) >= 10\nORDER BY on_time_share, avg_delay_s DESC"
        }
      ],
