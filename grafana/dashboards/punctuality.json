    {
      "id": 4,
      "type": "stat",
      "title": "Bunched pairs",
      "description": "Share of consecutive departures closer than half their scheduled headway.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(bunched_pairs)::float / nullif(sum(observed_pairs), 0) AS bunched\nFROM marts.mart_bunching\nWHERE service_date = '$day' AND mode IN ($mode)"
        }
      ],
