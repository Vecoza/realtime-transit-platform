    {
      "id": 9,
      "type": "table",
      "title": "Stops (measured delay vs timetable)",
      "description": "Stops with at least ten departures. At stops that are not timing points the timetable's times are approximate and can read up to two minutes late.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
