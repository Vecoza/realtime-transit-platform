      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT stop_code AS stop, stop_name AS name, modes,\n       sum(departures) AS departures,\n       round((sum(on_time_share * departures) / sum(departures))::numeric, 3) AS on_time_share,\n       round((sum(avg_delay_s * departures) / sum(departures))::numeric) AS avg_delay_s,\n       bool_or(is_timing_point) AS timing_point\nFROM marts.mart_stop_punctuality\nWHERE service_date = '$day'\nGROUP BY 1, 2, 3\nHAVING sum(departures) >= 10\nORDER BY avg_delay_s DESC\nLIMIT 50"
        }
      ],
