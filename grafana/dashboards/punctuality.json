          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Planned trips seen",
      "description": "Trips planned to depart while data was arriving that reported an arrival or departure. Metro and ferries send no stop events and are not counted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(seen_trips)::float / nullif(sum(expected_trips), 0) AS seen\nFROM marts.mart_data_completeness\nWHERE service_date = '$day' AND mode IN ($mode)"
        }
      ],
      "fieldConfig": {
