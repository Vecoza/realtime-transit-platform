POSTGRES_USER=transit
POSTGRES_PASSWORD=rtp_local_pw_2026
POSTGRES_DB=transit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP_SERVERS=localhost:19092
HFP_RAW_TOPIC=hfp.raw
HFP_DLQ_TOPIC=hfp.dlq
SINK_GROUP_ID=sink
# Static group membership; one distinct id per running sink (default: <group>-<hostname>)
# SINK_INSTANCE_ID=sink-1
SINK_BATCH_MAX_MESSAGES=5000
SINK_BATCH_MAX_MS=500

HSL_MQTT_HOST=mqtt.hsl.fi
HSL_MQTT_PORT=8883
HFP_EVENT_TYPES=vp,arr,dep
RECORDINGS_DIR=data/recordings

GTFS_URL=https://infopalvelut.storage.hsldev.com/gtfs/hsl.zip
GTFS_DOWNLOAD_DIR=data/gtfs

# Event-time aggregation (consumer group aggregator)
AGGREGATOR_GROUP_ID=aggregator
AGGREGATOR_ALLOWED_LATENESS_S=10
AGGREGATOR_CORRECTION_HORIZON_S=600
AGGREGATOR_IDLE_TIMEOUT_S=30
AGGREGATOR_STALE_AFTER_S=120
# AGGREGATOR_INSTANCE_ID=aggregator-1

# Storage lifecycle: days each kind of data stays in PostgreSQL before it moves to Parquet
ARCHIVE_DIR=data/archive
ARCHIVE_KEEP_DAYS_POSITIONS=2
ARCHIVE_KEEP_DAYS_STOP_EVENTS=7
ARCHIVE_KEEP_DAYS_MINUTE_STATS=7
ARCHIVE_KEEP_DAYS_TIMETABLE=2
# Analytical database built by dbt
DUCKDB_PATH=data/warehouse.duckdb
