      "options": {
        "mode": "markdown",
        "content": "**Measured delay vs timetable.** Departure delay measured by the platform against the published timetable, from the analytical marts (rebuilt hourly). Days and hours are Helsinki local time; on-time means between 60 s early and 180 s late, counted at timing points."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "On time at timing points",
      "description": "measured delay vs timetable",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(on_time)::float / nullif(sum(departures), 0) AS on_time\nFROM marts.mart_on_time_performance\nWHERE service_date = '$day' AND mode IN ($mode)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Departures at timing points",
      "description": "",
