    {
      "id": 11,
      "type": "table",
      "title": "Data completeness by line",
      "description": "Lines with at least the chosen number of expected trips (default 5), least complete first.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT route_short_name AS line, mode, expected_trips, seen_trips, seen_share\nFROM marts.mart_data_completeness\nWHERE service_date = '$day' AND mode IN ($mode) AND expected_trips >= $min_trips\nORDER BY seen_share, expected_trips DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
