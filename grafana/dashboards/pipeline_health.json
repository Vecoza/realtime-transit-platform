          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(finished_at)) AS seconds FROM meta.dbt_runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 7200
              },
              {
                "color": "red",
                "value": 14400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Last dbt runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT finished_at AS finished, round(elapsed_s::numeric, 1) AS seconds, models, tests, failed,\n       published_tables AS published\nFROM meta.dbt_runs\nORDER BY finished_at DESC\nLIMIT 5"
