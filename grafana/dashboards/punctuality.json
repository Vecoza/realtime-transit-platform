    {
      "id": 10,
      "type": "table",
      "title": "Bunching by line and stop",
      "description": "Pairs of consecutive trips observed at a stop; bunched below half, a gap above one and a half times the scheduled headway. Only lines and stops with at least the chosen number of observed pairs (default 5) are ranked.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "transit-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "transit-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT route_short_name AS line, mode, direction_id AS direction, stop_code AS stop, stop_name AS name,\n       sum(observed_pairs) AS pairs, sum(bunched_pairs) AS bunched, sum(gap_pairs) AS gaps,\n       round(avg(avg_scheduled_headway_s)::numeric) AS scheduled_headway_s,\n       round(avg(avg_observed_headway_s)::numeric) AS observed_headway_s\nFROM marts.mart_bunching\nWHERE service_date = '$day' AND mode IN ($mode)\nGROUP BY 1, 2, 3, 4, 5\nHAVING sum(bunched_pairs) > 0 AND sum(observed_pairs) >= $min_pairs\nORDER BY bunched DESC, pairs DESC\nLIMIT 50"
        }
      ],
